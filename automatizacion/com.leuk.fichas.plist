<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leuk.fichas</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/leuk-benchmark/pipeline/actualizar_fichas.sh</string>
  </array>

  <!-- Todos los días a las 7:30. Si la Mac está apagada, launchd lo corre
       al prenderla (cron no lo haría). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/com.leuk.fichas.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.leuk.fichas.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
